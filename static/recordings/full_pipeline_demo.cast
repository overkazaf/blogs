[0.011845, "o", "\r\n\u001b[1;36m╔══════════════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[1;36m║  Widevine L3 Keybox 批量生产 — 全流程演示               ║\u001b[0m\r\n\u001b[1;36m╚══════════════════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[1.013542, "o", "\u001b[1;33m━━━ Step 1: 使用 gen_keybox.py 批量生成 keybox ━━━\u001b[0m\r\n\r\n\u001b[90m$ python3 gen_keybox.py --batch 5\u001b[0m\r\n"]
[1.516158, "o", "  [0] device_id=L3_BATCH_ALPHA,   device_key=[REDACTED], file=keybox_0000.dat\r\n  [1] device_id=L3_BATCH_BRAVO,   device_key=[REDACTED], file=keybox_0001.dat\r\n"]
[1.516379, "o", "  [2] device_id=L3_BATCH_CHARLIE, device_key=[REDACTED], file=keybox_0002.dat\r\n  [3] device_id=L3_BATCH_DELTA,   device_key=[REDACTED], file=keybox_0003.dat\r\n  [4] device_id=L3_BATCH_ECHO,    device_key=[REDACTED], file=keybox_0004.dat\r\n\r\n"]
[1.516495, "o", "  \u001b[32m✓ Generated 5 keyboxes (<1ms each)\u001b[0m\r\n"]
[2.517989, "o", "\r\n"]
[2.518207, "o", "\u001b[1;33m━━━ Step 2: 注入 keybox → Google Provisioning ━━━\u001b[0m\r\n\r\n\u001b[90m  adb push L3_BATCH_ALPHA.dat → ay64.dat\u001b[0m\r\n"]
