@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI,Helvetica,Arial,sans-serif"
skinparam defaultFontSize 13
skinparam defaultFontColor #1e293b
skinparam shadowing false
skinparam roundCorner 8
skinparam sequenceArrowThickness 2
skinparam sequenceArrowColor #3b82f6
skinparam sequenceLifeLineBorderColor #94a3b8
skinparam sequenceParticipantBackgroundColor #f1f5f9
skinparam sequenceParticipantBorderColor #3b82f6
skinparam sequenceParticipantFontStyle bold
skinparam sequenceGroupBackgroundColor #fefce8
skinparam sequenceGroupBorderColor #ca8a04
skinparam sequenceGroupFontColor #854d0e
skinparam sequenceDividerBackgroundColor #f0f9ff
skinparam sequenceDividerBorderColor #3b82f6
skinparam noteBorderColor #f59e0b
skinparam noteBackgroundColor #fffbeb
skinparam noteFontColor #78350f


title <font size=16><b>MetaSec 六神签名初始化序列</b></font>

participant "Java Layer" as J
participant "JNI Bridge\nSO+0x271938" as JNI
participant "OLLVM\n调度器" as OLL
participant "Custom\nVM" as VM
participant "JIT\nEngine" as JIT

== <font color=#3b82f6>Phase 1: Context Init</font> (0x1000003) ==
J -> JNI : m.a(0x1000003, ctx)
JNI -> OLL : dispatch
OLL --> J : getPackageName(), getFilesDir()
OLL --> JNI : OK
JNI --> J : success

== <font color=#3b82f6>Phase 2: Library Init</font> (0x5000001) ==
J -> JNI : m.a(0x5000001, configArray)
JNI -> OLL : dispatch
note right of OLL #fff3cd
  <font color=#856404><b>Gate:</b> env var
  28d7fdd5...=a7
  Missing -> exit(0)</font>
end note
OLL -> JIT : generate code (~360KB)
JIT --> OLL : 0x12540000
OLL --> JNI : return 0
JNI --> J : Integer(0)

== <font color=#3b82f6>Phase 2.5: String Decrypt</font> (0x1000001) ==
J -> JNI : decrypt
note right of JNI : 12,734 encrypted strings
JNI --> J : decrypted

== <font color=#16a34a><b>Phase 3: Config Verify</b></font> (0x4000001) ==
J -> JNI : m.a(0x4000001, jsonConfig)
JNI -> VM : execute bytecode
note right of VM #dcfce7
  <font color=#166534><b>Core Breakthrough</b>
  Validate 17 JSON fields
  field[4] = Java static value
  NOT native decrypted value</font>
end note
VM --> JNI : 3173 ops -> TRUE
JNI --> J : Boolean.TRUE

== <font color=#3b82f6>Phase 4: Get Session</font> (0x4000002) ==
J -> JNI : m.a(0x4000002)
JNI -> OLL : dispatch
OLL --> JNI : Long(0x1273****)
JNI --> J : session handle

== <font color=#7c3aed><b>Phase 6: getFeatureHash</b></font> (0x2000006) ==
J -> JNI : m.a(0x2000006, handle, url, body)
JNI -> JIT : CAS loop (4 iter)
note right of JIT #f3e8ff
  <font color=#6b21a8>ldaxrh/stxrh atomic
  4 iterations converge</font>
end note
JIT --> JNI : String[12]
JNI --> J : <font color=#7c3aed><b>X-Gorgon, X-Khronos\nX-Argus, X-Ladon\nX-Helios, X-Medusa</b></font>

@enduml