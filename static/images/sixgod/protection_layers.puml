@startuml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI,Helvetica,Arial,sans-serif"
skinparam defaultFontSize 13
skinparam defaultFontColor #1e293b
skinparam shadowing false
skinparam roundCorner 8
skinparam componentBackgroundColor #f1f5f9
skinparam componentBorderColor #3b82f6
skinparam packageBackgroundColor #f8fafc
skinparam packageBorderColor #64748b
skinparam noteBorderColor #f59e0b
skinparam noteBackgroundColor #fffbeb
skinparam noteFontColor #78350f
skinparam arrowColor #3b82f6


title <font size=16><b>MetaSec 保护层架构</b></font>\nlibmetasec_ml.so (3.8MB, ARM64)

package "Layer 1: OLLVM 控制流平坦化" as L1 #e0f2fe {
  component "主调度器\nSO+0x173ec4" as OLL #bfdbfe
  note right of OLL
    madd/mul 哈希状态转移
    所有关键函数平坦化
  end note

  package "Layer 2: 自定义 VM 字节码" as L2 #fef3c7 {
    component "VM 解释器\nSO+0x1702a8" as VM #fde68a
    note right of VM
      32-bit 指令字解码
      ubfx/and/orr 位域提取
    end note

    package "Layer 3: JIT 代码生成" as L3 #fce7f3 {
      component "运行时代码\n0x12540000" as JIT #f9a8d4
      note right of JIT
        Phase 2 动态生成 ~360KB
        PLT stub + CAS 计算循环
      end note
    }
  }
}

rectangle "<b>辅助防御</b>" as AUX #f8fafc {
  component "自毁处理器 x3\n~71 调用点" as TRAP #fecaca
  component "反仿真\n静默 exit(0)" as ANTI #fed7aa
  component "加密字符串\nx12,734" as STR #e9d5ff
  component "自修改代码\nSO+0x18b054" as SMC #bae6fd
  component "JNI 混淆\nRegisterNatives->Object" as JNIOB #d1fae5
}

@enduml